# Central brand override (safe for client bundle)
VITE_APP_NAME=Forge
VITE_APP_TAGLINE=온체인 사실을 숨기지 않는 커뮤니티 런치 마켓

# Local Anvil
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337
LOCAL_CONFIRMATIONS=1
INDEXER_PORT=8787
VITE_INDEXER_URL=http://127.0.0.1:8787
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Anvil (Forge local fixture)
VITE_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
VITE_GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io
# Web execution remains disabled unless this exact test-only mode and every
# deployment value below are set from one verified GIWA Sepolia deployment.
VITE_GIWA_DEPLOYMENT_MODE=disabled
VITE_GIWA_FACTORY_ADDRESS=
VITE_GIWA_PROTOCOL_CONFIG_ADDRESS=
VITE_GIWA_SELF_HOSTED_AMM_ADAPTER_ADDRESS=
VITE_GIWA_DEPLOYED_BLOCK=

# Filled inside the ignored .data directory by scripts/local-stack.ts.
LOCAL_DEPLOYMENT_MANIFEST=.data/local-stack/deployment.json
VITE_FACTORY_ADDRESS=
VITE_PROTOCOL_CONFIG_ADDRESS=
VITE_LOCAL_AMM_ADAPTER_ADDRESS=

# GIWA values must be copied from current official primary sources.
# The application remains fail-closed while any required value is absent.
GIWA_TESTNET_ENABLED=false
# Verified against official GIWA docs and live RPC on 2026-07-28.
GIWA_TESTNET_CHAIN_ID=91342
GIWA_TESTNET_RPC_URL=https://sepolia-rpc.giwa.io
# No general-purpose JSON-RPC WebSocket is documented. Keep unset.
GIWA_TESTNET_WS_URL=
GIWA_TESTNET_EXPLORER_URL=https://sepolia-explorer.giwa.io
GIWA_TESTNET_NATIVE_NAME=Ether
GIWA_TESTNET_NATIVE_SYMBOL=ETH
GIWA_TESTNET_NATIVE_DECIMALS=18
# GIWA documents safe/finalized tags, not an app-wide fixed confirmation count.
GIWA_TESTNET_FINALITY_TAG=safe
GIWA_TESTNET_BRIDGE_URL=https://sepolia-bridge.giwa.io/
GIWA_TESTNET_FAUCET_URL=https://faucet.giwa.io/
GIWA_TESTNET_AMM_FACTORY=
GIWA_TESTNET_AMM_ROUTER=
GIWA_TESTNET_WRAPPED_NATIVE=

# GIWA contract deployment only. Import a dedicated testnet account into
# Foundry's local encrypted keystore and invoke the script with `--account`.
# Only the public address belongs here. Never commit, chat, or save its private
# key, seed phrase, or keystore password in an env file.
# The self-hosted mode is GIWA Sepolia-only, unaudited, and reports test-only
# on-chain. It cannot be combined with the separately approved V2 path.
USE_SELF_HOSTED_TEST_AMM=false
GIWA_AMM_INTEGRATION_APPROVED=false
GIWA_V2_FACTORY=
GIWA_V2_ROUTER=
GIWA_WRAPPED_NATIVE=
DEPLOYER_ADDRESS=
FEE_RECIPIENT=
CREATION_FEE_WEI=0
MIN_INITIAL_LIQUIDITY_WEI=1000000000000000

# Indexer server. Configure chain ID, RPC, and factory together or the process
# exits without polling. Never prefix server secrets with VITE_.
INDEXER_DATABASE_PATH=.data/indexer.sqlite
INDEXER_SOURCE=onchain-indexer
INDEXER_CORS_ORIGIN=http://127.0.0.1:5173
INDEXER_UPLOAD_DIRECTORY=.data/uploads
INDEXER_PUBLIC_BASE_URL=http://127.0.0.1:8787
INDEXER_CHAIN_ID=
INDEXER_RPC_URL=
INDEXER_FACTORY_ADDRESS=
INDEXER_START_BLOCK=0
# Empty selects `safe` for GIWA Sepolia (91342), `latest` for local Anvil.
INDEXER_FINALITY_TAG=
# Empty selects standard V2 pair events on GIWA and local fixture events on
# Anvil. The self-hosted GIWA deployment must explicitly set
# `giwa-self-hosted-test-only`; contradictory chain/kind pairs fail closed.
INDEXER_POOL_EVENT_KIND=
INDEXER_POLL_INTERVAL_MS=1000
# Shared fail-closed bucket by default. Raise/lower for the deployment profile.
INDEXER_RATE_LIMIT_PER_MINUTE=600
# Configure only behind a trusted proxy that strips and rewrites this header.
# Supported: cf-connecting-ip, x-real-ip. Empty keeps one shared bucket.
INDEXER_TRUSTED_PROXY_IP_HEADER=
