{
  "name": "@forge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:public-demo": "tsc -p tsconfig.json && VITE_PUBLIC_DEMO=true vite build",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/chain-config": "workspace:*",
    "@forge/sdk": "workspace:*",
    "@forge/shared": "workspace:*",
    "@forge/ui": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "viem": "^2.33.2",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.6"
  }
}
