{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/deployment-manifest.json",
  "title": "Forge contract deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "addressOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonZeroAddress"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonZeroAddress": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "deploymentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployedBlock",
        "broadcastTxHashes",
        "adapterId",
        "protocolConfigRuntimeCodeHash",
        "launchFactoryRuntimeCodeHash",
        "ammAdapterRuntimeCodeHash",
        "verifiedSourceUrls"
      ],
      "properties": {
        "deployedBlock": {
          "type": "integer",
          "minimum": 1
        },
        "broadcastTxHashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bytes32"
          }
        },
        "adapterId": {
          "$ref": "#/$defs/bytes32"
        },
        "protocolConfigRuntimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "launchFactoryRuntimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "ammAdapterRuntimeCodeHash": {
          "$ref": "#/$defs/bytes32"
        },
        "verifiedSourceUrls": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "network",
    "chainId",
    "deployed",
    "contracts",
    "ammIntegration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "enum": ["giwa-testnet", "local-anvil"]
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "deployed": {
      "type": "boolean"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolConfig": {
          "$ref": "#/$defs/addressOrNull"
        },
        "launchFactory": {
          "$ref": "#/$defs/addressOrNull"
        },
        "ammAdapter": {
          "$ref": "#/$defs/addressOrNull"
        },
        "localConstantProductAdapter": {
          "$ref": "#/$defs/addressOrNull"
        }
      }
    },
    "ammIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "integrationApproved"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "integrationApproved": {
          "type": "boolean"
        },
        "testOnly": {
          "type": "boolean"
        }
      }
    },
    "deploymentEvidence": {
      "$ref": "#/$defs/deploymentEvidence"
    },
    "blocker": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "network": {
            "const": "giwa-testnet"
          }
        },
        "required": ["network"]
      },
      "then": {
        "type": "object",
        "properties": {
          "chainId": {
            "const": 91342
          },
          "contracts": {
            "type": "object",
            "required": ["protocolConfig", "launchFactory", "ammAdapter"],
            "properties": {
              "protocolConfig": {
                "$ref": "#/$defs/addressOrNull"
              },
              "launchFactory": {
                "$ref": "#/$defs/addressOrNull"
              },
              "ammAdapter": {
                "$ref": "#/$defs/addressOrNull"
              },
              "localConstantProductAdapter": false
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "chainId": {
            "const": 31337
          },
          "contracts": {
            "type": "object",
            "required": [
              "protocolConfig",
              "launchFactory",
              "localConstantProductAdapter"
            ],
            "properties": {
              "protocolConfig": {
                "$ref": "#/$defs/addressOrNull"
              },
              "launchFactory": {
                "$ref": "#/$defs/addressOrNull"
              },
              "localConstantProductAdapter": {
                "$ref": "#/$defs/addressOrNull"
              },
              "ammAdapter": false
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "deployed": {
            "const": true
          }
        },
        "required": ["deployed"]
      },
      "then": {
        "type": "object",
        "required": ["deploymentEvidence"],
        "properties": {
          "contracts": {
            "type": "object",
            "properties": {
              "protocolConfig": {
                "$ref": "#/$defs/nonZeroAddress"
              },
              "launchFactory": {
                "$ref": "#/$defs/nonZeroAddress"
              },
              "ammAdapter": {
                "$ref": "#/$defs/nonZeroAddress"
              },
              "localConstantProductAdapter": {
                "$ref": "#/$defs/nonZeroAddress"
              }
            }
          },
          "deploymentEvidence": {
            "$ref": "#/$defs/deploymentEvidence"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "contracts": {
            "type": "object",
            "properties": {
              "protocolConfig": {
                "type": "null"
              },
              "launchFactory": {
                "type": "null"
              },
              "ammAdapter": {
                "type": "null"
              },
              "localConstantProductAdapter": {
                "type": "null"
              }
            }
          },
          "deploymentEvidence": false
        },
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "blocker": {
                "type": "string"
              }
            },
            "required": ["blocker"]
          },
          {
            "type": "object",
            "properties": {
              "note": {
                "type": "string"
              }
            },
            "required": ["note"]
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "ammIntegration": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "forge-self-hosted-constant-product-testnet"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["ammIntegration"]
      },
      "then": {
        "type": "object",
        "properties": {
          "network": {
            "const": "giwa-testnet"
          },
          "ammIntegration": {
            "type": "object",
            "properties": {
              "testOnly": {
                "const": true
              }
            },
            "required": ["testOnly"]
          },
          "deploymentEvidence": {
            "type": "object",
            "properties": {
              "adapterId": {
                "const": "0x7cc46dc44520b82e1e4f957c97a99ddaf86723ac155212e8cabe0850adab8567"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "deployed": {
            "const": true
          }
        },
        "required": ["deployed"]
      },
      "then": {
        "type": "object",
        "properties": {
          "ammIntegration": {
            "type": "object",
            "properties": {
              "integrationApproved": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
