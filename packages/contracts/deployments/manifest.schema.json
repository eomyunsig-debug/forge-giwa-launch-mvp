{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/deployment-manifest.json",
  "title": "Forge contract deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "chainId",
    "deployed",
    "contracts",
    "ammIntegration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "type": "string",
      "minLength": 1
    },
    "chainId": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "deployed": {
      "type": "boolean"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"],
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "ammIntegration": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "integrationApproved"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "integrationApproved": {
          "type": "boolean"
        },
        "testOnly": {
          "type": "boolean"
        }
      }
    },
    "blocker": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployed": {
            "const": true
          }
        },
        "required": ["deployed"]
      },
      "then": {
        "properties": {
          "contracts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        }
      },
      "else": {
        "properties": {
          "contracts": {
            "type": "object",
            "additionalProperties": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
