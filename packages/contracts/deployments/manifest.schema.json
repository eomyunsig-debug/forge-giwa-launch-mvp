{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/deployment-manifest.json",
  "title": "Forge contract deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "addressOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonZeroAddress"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonZeroAddress": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    }
  },
  "required": [
    "schemaVersion",
    "network",
    "chainId",
    "deployed",
    "contracts",
    "ammIntegration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "enum": ["giwa-testnet", "local-anvil"]
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "deployed": {
      "type": "boolean"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolConfig": {
          "$ref": "#/$defs/addressOrNull"
        },
        "launchFactory": {
          "$ref": "#/$defs/addressOrNull"
        },
        "ammAdapter": {
          "$ref": "#/$defs/addressOrNull"
        },
        "localConstantProductAdapter": {
          "$ref": "#/$defs/addressOrNull"
        }
      }
    },
    "ammIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "integrationApproved"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "integrationApproved": {
          "type": "boolean"
        },
        "testOnly": {
          "type": "boolean"
        }
      }
    },
    "blocker": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "network": {
            "const": "giwa-testnet"
          }
        },
        "required": ["network"]
      },
      "then": {
        "type": "object",
        "properties": {
          "chainId": {
            "const": 91342
          },
          "contracts": {
            "type": "object",
            "required": ["protocolConfig", "launchFactory", "ammAdapter"],
            "properties": {
              "protocolConfig": {
                "$ref": "#/$defs/addressOrNull"
              },
              "launchFactory": {
                "$ref": "#/$defs/addressOrNull"
              },
              "ammAdapter": {
                "$ref": "#/$defs/addressOrNull"
              },
              "localConstantProductAdapter": false
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "chainId": {
            "const": 31337
          },
          "contracts": {
            "type": "object",
            "required": [
              "protocolConfig",
              "launchFactory",
              "localConstantProductAdapter"
            ],
            "properties": {
              "protocolConfig": {
                "$ref": "#/$defs/addressOrNull"
              },
              "launchFactory": {
                "$ref": "#/$defs/addressOrNull"
              },
              "localConstantProductAdapter": {
                "$ref": "#/$defs/addressOrNull"
              },
              "ammAdapter": false
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "deployed": {
            "const": true
          }
        },
        "required": ["deployed"]
      },
      "then": {
        "type": "object",
        "properties": {
          "contracts": {
            "type": "object",
            "properties": {
              "protocolConfig": {
                "$ref": "#/$defs/nonZeroAddress"
              },
              "launchFactory": {
                "$ref": "#/$defs/nonZeroAddress"
              },
              "ammAdapter": {
                "$ref": "#/$defs/nonZeroAddress"
              },
              "localConstantProductAdapter": {
                "$ref": "#/$defs/nonZeroAddress"
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "contracts": {
            "type": "object",
            "properties": {
              "protocolConfig": {
                "type": "null"
              },
              "launchFactory": {
                "type": "null"
              },
              "ammAdapter": {
                "type": "null"
              },
              "localConstantProductAdapter": {
                "type": "null"
              }
            }
          }
        },
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "blocker": {
                "type": "string"
              }
            },
            "required": ["blocker"]
          },
          {
            "type": "object",
            "properties": {
              "note": {
                "type": "string"
              }
            },
            "required": ["note"]
          }
        ]
      }
    }
  ]
}
